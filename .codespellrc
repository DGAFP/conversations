[codespell]
skip =
    # French operational documentation is outside the English dictionary.
    ./docs/assistant-rh/identity.md,
    ./docs/assistant-rh/documents.md,
    ./docs/assistant-rh/feedback.md,
    ./deploy/kapsule/PROCONNECT.md,
    ./deploy/kapsule/PROCONNECT-QUALIFICATION.md,
    ./git/,
    **/*.pdf,
    **/*.po,
    **/*.pot,
    **/*.json,
    **/yarn.lock,
    **/node_modules/**,
    **/e2e/report/**,
    *.tsbuildinfo,
    **/uv.lock,
    ./docker/files/etc/mime.types,
    ./src/backend/chat/evals,
check-filenames = true
ignore-words-list =
    # French authentication messages and feedback vocabulary.
    adresse,
    connexion,
    complet,
    contribue,
    exemple,
    invalide,
    mot,
    afterAll,
    projet,
    statics,

